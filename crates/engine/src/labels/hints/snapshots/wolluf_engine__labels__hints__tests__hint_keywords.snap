---
source: crates/engine/src/labels/hints/tests.rs
expression: "lines.join(\"\\n\")"
---
minijack hint_pattern regular.jack.minijack Anywhere [minijack, mini jack]
longjack hint_pattern regular.jack.longjack Anywhere [longjack, long jack]
chordjack hint_pattern regular.jack.chordjack Anywhere [chordjack, chord jack]
anchor hint_pattern regular.jack.anchor SkillContext [anchor]
bracket hint_pattern regular.stream.bracket Anywhere [bracket]
chordbracket hint_pattern regular.stream.chordbracket Anywhere [chordbracket, chord bracket]
jumptrill hint_pattern regular.stream.jumptrill Anywhere [jumptrill, jump trill]
split_trill hint_pattern regular.stream.split_trill Anywhere [split trill, splittrill]
trill hint_pattern regular.stream.trill Anywhere [trill]
roll hint_pattern regular.stream.roll SkillContext [roll, stair, staircase]
jumpstream hint_pattern regular.stream.jumpstream Anywhere [jumpstream, jump stream]
handstream hint_pattern regular.stream.handstream Anywhere [handstream, hand stream]
chordstream hint_axis 7k.regular.stream Anywhere [chordstream, chord stream]
chordstream_light hint_pattern regular.stream.chordstream_light Anywhere [light chordstream, light chord stream]
chordstream_dense hint_pattern regular.stream.chordstream_dense Anywhere [dense chordstream, dense chord stream]
burst hint_pattern regular.speed.burst SkillContext [burst]
delay hint_pattern regular.speed.delay Anywhere [delay, delaymaster]
inverse hint_pattern ln.inverse.gap SkillContext [inverse, ln inverse]
release hint_pattern ln.release.timing SkillContext [release, ln release]
shield hint_pattern ln.tech.shield SkillContext [shield, ln shield]
hybrid hint_pattern ln.tech.hybrid SkillContext [hybrid, ln hybrid]
jack hint_axis 7k.regular.jack SkillContext [jack]
tech hint_axis 7k.regular.tech SkillContext [tech, technical]
speed hint_axis 7k.regular.speed SkillContext [speed]
stream hint_axis 7k.regular.stream SkillContext [stream]
stamina hint_axis 7k.regular.stream SkillContext [stamina]
ln hint_axis 7k.ln.general Anywhere [ln, long note, longnote, fln, full ln]
ln_tech hint_axis 7k.ln.tech Anywhere [ln tech, ln technical]

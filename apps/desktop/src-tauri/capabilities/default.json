{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "F0 main window: core IPC, folder picker, UI log forwarding, opening paths inside the wolluf data dir.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "log:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$LOCALDATA/wolluf/**" }]
    }
  ]
}
